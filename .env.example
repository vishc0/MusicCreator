# MusicCreator Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Required: Hugging Face API Key
# Get it from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Additional LLM API Keys
# OpenAI (if using GPT models)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (if using Claude models)
# ANTHROPIC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (free tier, fast inference)
# GROQ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Together AI (free credits available)
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Publishing Settings
# Set to true to enable automatic publishing
ENABLE_PUBLISH=false

# GitHub Personal Access Token (for publishing)
# Required if ENABLE_PUBLISH=true
# Get it from: https://github.com/settings/tokens
# PUBLISH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Web Interface Settings
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key

# Logging
LOG_LEVEL=INFO

# Cache Settings
ENABLE_CACHE=true
CACHE_DIR=.cache

# Performance
MAX_WORKERS=4
